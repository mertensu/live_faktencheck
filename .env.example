# ===========================================
# Fact-Check Application Configuration
# ===========================================
# Copy this file to .env and fill in your keys:  cp .env.example .env
#
# Use your OWN development keys here, never the production ones. Set a spending
# limit at each provider — a runaway local test must not be able to eat the live
# budget during a broadcast.

# ===========================================
# API Keys (required)
# ===========================================

ASSEMBLYAI_API_KEY=your_assemblyai_api_key
GEMINI_API_KEY=your_google_gemini_api_key
# Alternative: GOOGLE_API_KEY also works
TAVILY_API_KEY=your_tavily_api_key

# ===========================================
# Access gate (required — the backend is fail-closed)
# ===========================================
# Without this the app starts, but EVERY cost-incurring endpoint rejects all
# requests (POST /api/sessions, audio-block, text-block, approve-claims,
# fact-checks/resend, PUT /api/fact-checks/{id}, pipeline retrigger) — with no
# obvious hint as to why. Set it before you start.
#
# Format: comma-separated  name:code  or  name:code:quick_check_limit
#   dev:letmein             -> default cap of 3 lifetime quick checks
#   dev:letmein:unlimited   -> no cap (use for local development)
#   dev:letmein:20          -> custom cap
#
# Seeding is ONE-SHOT: codes are written only while the `codes` table is empty.
# Changing this later has no effect on an existing DB — see docs/deployment.md.

ACCESS_CODES=dev:letmein:unlimited

# Lifetime live-audio cap per code, applied at seeding time (default: 5).
LIVE_AUDIO_LIMIT_MINUTES=5

# ===========================================
# Model Configuration
# ===========================================
# See: https://ai.google.dev/gemini-api/docs/models

GEMINI_MODEL_CLAIM_EXTRACTION=gemini-2.5-pro
GEMINI_MODEL_FACT_CHECKER=gemini-2.5-pro
GEMINI_MODEL_SELF_CRITIQUE=gemini-2.5-flash

# Intentionally EMPTY in production: skips the weak Gemini-Flash intermediate
# step so the fact-checker falls straight through to the cross-provider fallback.
GEMINI_MODEL_FACT_CHECKER_FALLBACK=

# Self-critique step after fact-checking (set to "false" to disable)
SELF_CRITIQUE_ENABLED=true

# ===========================================
# Cross-provider fallback (optional but recommended)
# ===========================================
# Survives a full Google outage (quota/auth/downtime) during a live broadcast by
# appending a non-Google model as the last tier — Claude via Requesty, EU-hosted.
# Without REQUESTY_API_KEY the pipeline runs Google-only and stays functional.

# Left commented out on purpose: a placeholder value here would switch the fallback
# ON with a key that cannot work, turning a Google hiccup into a confusing auth error.
# Uncomment only once you have a real key.
# REQUESTY_API_KEY=your_requesty_api_key
# PROVIDER_FALLBACK_ENABLED=true                  # "false" disables entirely
# PROVIDER_FALLBACK_MODEL=claude-opus-4-8@eu      # Requesty router across EU backends
# REQUESTY_BASE_URL=https://router.requesty.ai/v1

# ===========================================
# Observability (optional)
# ===========================================
# Without a token, Logfire is a silent no-op — the app runs normally.
# Live project: https://logfire-eu.pydantic.dev/mertensu/fact-check

# LOGFIRE_TOKEN=your_logfire_token

# ======================
# Search configuration
# ======================

TAVILY_SEARCH_DEPTH=basic   # "basic" or "advanced"; leave empty to let the agent choose
TAVILY_MAX_RESULTS=5

# ===========================================
# Processing Configuration
# ===========================================

# Parallel fact-checking (default: false = sequential processing)
FACT_CHECK_PARALLEL=true

# Maximum concurrent fact-checks within a single batch (parallel mode only)
FACT_CHECK_MAX_WORKERS=4

# Maximum concurrent approval batches processed simultaneously
FACT_CHECK_MAX_CONCURRENCY=2

# Max agent iterations (default 25). Use 5-10 to keep test runs fast.
# FACT_CHECK_RECURSION_LIMIT=25

# ===========================================
# Server Configuration
# ===========================================

# Port for `python -m backend.app` (production sets it on the uvicorn command line)
PORT=5000

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# "memory" runs against a throwaway in-memory DB with no persistence
# DB_MODE=file

# Language for LLM schema descriptions
LANG=de

# ===========================================
# Frontend Configuration (Vite)
# ===========================================

# Backend URL for production builds
VITE_BACKEND_URL=https://api.live-faktencheck.de

# N8N webhook URL for verified claims (optional)
# VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/verified-claims
